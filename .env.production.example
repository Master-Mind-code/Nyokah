# ---------------------------------------------------------------------------
# Deploiement Docker de Nyokah (docker-compose.yml a la racine)
# Copiez ce fichier vers .env sur le serveur puis adaptez les valeurs.
# ---------------------------------------------------------------------------

# URL publique de l'application, sans slash final.
# Sur AWS : http://<IP-publique-EC2>  (ou votre nom de domaine)
PUBLIC_URL=http://localhost

# Port hote expose par nginx
HTTP_PORT=80

# Base de donnees (le conteneur n'est pas expose a l'exterieur)
POSTGRES_USER=nyokah
POSTGRES_PASSWORD=change-me-mot-de-passe-solide
POSTGRES_DB=nyokah

# Secrets JWT : 32 caracteres minimum, generez-les avec
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Documentation Swagger servie sur /docs
ENABLE_SWAGGER=true

# Compte administrateur cree par le seed
SEED_ADMIN_EMAIL=admin@nyokah.ci
SEED_ADMIN_PASSWORD=Nyokah@2026
