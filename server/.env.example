# ---------------------------------------------------------------------------
# Nyokah API — variables d'environnement
# Copiez ce fichier vers .env puis adaptez les valeurs.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# URL publique de l'API (liens de paiement, callbacks, documentation)
API_URL=http://localhost:4000

# Base de donnees PostgreSQL
# Le docker-compose fourni publie le conteneur sur le port hote 5442 pour ne pas
# entrer en conflit avec un PostgreSQL deja installe localement (5432).
DATABASE_URL=postgresql://nyokah:nyokah@127.0.0.1:5442/nyokah?schema=public

# Origines autorisees pour le CORS, separees par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Secrets JWT — GENEREZ DES VALEURS UNIQUES EN PRODUCTION
# (ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-au-moins-32-caracteres
JWT_REFRESH_SECRET=change-me-refresh-secret-au-moins-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Regles metier par defaut (surchargeables via la table settings)
VAT_RATE=0.18
CURRENCY=XOF

# Fournisseur de notifications : mock | whatsapp_cloud
NOTIFICATION_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Fournisseur d'e-mails : mock | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@nyokah.ci

# Fournisseur de paiement : mock | cinetpay
PAYMENT_PROVIDER=mock
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:3000/paiement/retour

# Compte super-administrateur cree par le seed
SEED_ADMIN_EMAIL=admin@nyokah.ci
SEED_ADMIN_PASSWORD=Nyokah@2026
